rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones de validación de roles
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }
    
    function isSuperAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // ─── RESERVA DE USERNAMES ──────────────────────────────────────────
    match /usernames/{username} {
      // Lectura pública para validación rápida de disponibilidad (debounce)
      allow read: if true;
      
      // Creación permitida si el usuario asigna su propio UID, la data contiene solo UID y createdAt, y el formato de username es válido (3-20 caracteres alfanuméricos)
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && username.matches('^[a-z0-9_]{3,20}$');
                    
      // Actualización denegada para evitar secuestro de identidad
      allow update: if false;
      
      // Borrado permitido por el dueño actual, O por un administrador para moderación
      allow delete: if request.auth != null 
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ─── PERFILES DE USUARIO ───────────────────────────────────────────
    match /users/{userId} {
      // Los perfiles ya no son de lectura pública universal para proteger datos sensibles (emails, subs).
      // El SSR usa Admin SDK para renderizar landings públicas.
      allow read:  if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      allow create: if request.auth != null && (
        (request.auth.uid == userId 
          && (!('role' in request.resource.data) || request.resource.data.role == 'user')
          && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
          && !('subscriptionEndsAt' in request.resource.data)
          && !('subscriptionId' in request.resource.data)
          && !('isSubscriptionCancelled' in request.resource.data)
          && !('processedPayments' in request.resource.data)
        ) ||
        (isAdmin() && (!('role' in request.resource.data) || isSuperAdmin()))
      );
      
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 
          'plan', 
          'subscriptionEndsAt', 
          'subscriptionId', 
          'isSubscriptionCancelled', 
          'processedPayments'
        ])) ||
        (isAdmin() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isSuperAdmin()))
      );
      
      allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());

      // ── Subcollección de analíticas VIP ──────────────────────────────
      // El dueño puede leer sus propios datos de analíticas (para el dashboard VIP).
      // La escritura está bloqueada desde el cliente — solo el Admin SDK (server-side)
      // puede escribir vía /api/analytics/track.
      match /analytics/{date} {
        allow read:  if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    // ─── BLOQUES BENTO ─────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read:   if true;
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || isAdmin());
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
